[Unit]
Description=Pattern Watcher subscription API (no signing keys)
After=network-online.target postgresql.service pons-market-monitor.service
Wants=network-online.target

[Service]
User=pw-billing
Group=pw-billing
WorkingDirectory=/opt/pw-billing/current
ExecStart=/usr/bin/node scripts/run-monitor-billing.mjs /etc/pw-billing/config.json
StateDirectory=pw-billing
Restart=on-failure
RestartSec=15
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
